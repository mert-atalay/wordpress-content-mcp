# Copy to .env and fill in. Never commit the real file.
# The server does not read .env by itself. Either set these in your MCP client
# config, or start it with: node --env-file=.env dist/index.js

# Site root. Must be https, except for localhost.
WP_BASE_URL=https://example.com

# A WordPress user and an application password for that user.
# Create one in WordPress under Users > Profile > Application Passwords.
# Use an account with the lowest role that does the job (Editor is enough).
WP_USERNAME=your-wordpress-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional. true turns off every write, including drafts and alt text.
WP_READ_ONLY=false
